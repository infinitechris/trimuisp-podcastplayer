FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        wget \
        file \
        make \
        patch \
        pkg-config \
        python3 \
        python3-pip \
        bison \
        flex \
        autoconf \
        automake \
        libtool \
        zip \
        xz-utils \
        rsync \
        unzip \
        locales \
        libsdl2-dev \
        libglib2.0-dev \
        libpng-dev \
        libfreetype6-dev \
        libxml2-dev \
        libasound2-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen C.UTF-8 \
    && update-locale LANG=C.UTF-8 LC_ALL=C.UTF-8

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /workspace
